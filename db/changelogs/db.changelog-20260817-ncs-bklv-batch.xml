<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

    <!-- SETTLE_NCS_BKLV_BATCH — netfile header for the NCS-to-BKLV SOAP surface
         (upload_File_GI_FLATFILE). Each line inside a submitted netfile becomes
         its own SETTLE_BKLV row (see below), linked back here via BATCH_ID. -->
    <changeSet id="20260817-01-create-settle-ncs-bklv-batch" author="sis-backend">
        <createTable tableName="SETTLE_NCS_BKLV_BATCH">
            <column name="settle_ncs_bklv_batch_id" type="NUMBER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="system_id" type="NUMBER">
                <constraints nullable="false" foreignKeyName="FK_NCS_BKLV_BATCH_SYSTEM" references="SYSTEM(SYSTEM_ID)"/>
            </column>
            <column name="file_name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="currency_code" type="varchar(10)"/>
            <column name="batch_status_id" type="NUMBER">
                <constraints nullable="false" foreignKeyName="FK_NCS_BKLV_BATCH_STATUS" references="STATUS(STATUS_ID)"/>
            </column>
            <column name="submitted_content" type="CLOB"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="20260817-03-add-settlement-account-number-to-system" author="sis-backend">
        <addColumn tableName="SYSTEM">
            <column name="settlement_account_number" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
