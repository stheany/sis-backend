# =========================================
# Flask Runtime
# =========================================
FLASK_ENV=development         # "development" or "production"
FLASK_DEBUG=1                 # 1=on, 0=off (use 0 in prod)

# Optional host/port overrides (for flask run)
FLASK_RUN_HOST=
FLASK_RUN_PORT=

# Optional HTTPS in dev (leave empty if not using yet)
FLASK_RUN_CERT=               # e.g., certs/server.crt
FLASK_RUN_KEY=                # e.g., certs/server.key


# =========================================
# App Secrets
# =========================================
APP_SECRET_KEY=
JWT_SECRET_KEY=
# CSRF session signing key — must be a long random string, never "secret"
CSRF_SESSION_KEY=


# =========================================
# Database (Oracle SIS)
# =========================================
DB_SERVICE_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=


# =========================================
# Flexcube
# =========================================
# Flexcube Database Host and Credential Configs
FLEXCUBE_DB_HOST=
FLEXCUBE_DB_USERNAME=
FLEXCUBE_DB_PASSWORD=
# Flexcube URL
FLEXCUBE_URL=
# Set to true in production; false only for local dev with self-signed certs
FLEXCUBE_VERIFY_SSL=true


# =========================================
# Iroha
# =========================================
IROHA_HOST=
# Iroha Account Key
VAULT_KEY=
FIS_KEY=
NBC_KEY=
# Iroha Account
VAULT_ACCOUNT=
FIS_ACCOUNT=
NBC_ACCOUNT=


# =========================================
# CORS
# =========================================
# Comma-separated list of allowed origins (e.g. https://app.example.com,https://admin.example.com)
# Leave empty only for local development — MUST be set in production.
CORS_ALLOWED_ORIGINS=


# =========================================
# RabbitMQ
# =========================================
RABBIT_USER=
RABBIT_PASS=
RABBIT_HOST=
RABBIT_PORT=
# =========================================
# Mail (SMTP)
# =========================================
MAIL_SERVER=smtp.gmail.com       # e.g. smtp.gmail.com or your NBC mail server
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=                   # your sender email address
MAIL_PASSWORD=                   # your email password or app password
MAIL_DEFAULT_SENDER=             # defaults to MAIL_USERNAME if empty
